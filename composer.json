{
    "name": "super-admin-org/page-designer",
    "description": "Page designer for open admin",
    "type": "library",
    "keywords": [
        "super-admin",
        "page",
        "designer",
        "free",
        "random"
    ],
    "homepage": "https://github.com/super-admin-org/page-designer",
    "license": "MIT",
    "authors": [
        {
            "name": "super-admin",
            "email": "info@super-admin.org"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "super-admin-org/ckeditor": "^1.0",
        "super-admin-org/super-admin": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SuperAdmin\\Admin\\PageDesigner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperAdmin\\Admin\\PageDesigner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SuperAdmin\\Admin\\PageDesigner\\PageDesignerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
